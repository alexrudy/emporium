{
    auto_https off
    http_port 8080
    debug

}
localhost:8080 {

    @auth path /auth/*
    handle @auth {
        reverse_proxy localhost:3030
    }

    handle {
        forward_auth localhost:3030 {
            uri /proxy/verify

            @error status 403
            handle_response @error {
                redir * http://localhost:8080/auth/login
            }
        }
    	respond "Hello, world!"
	}
}

(gateway) {
	route {
		reverse_proxy /auth/* unix//run/gateway/gateway.sock {
			# Public origin of this host; ogateway appends each provider's
			# callback path. (A full callback URL also works: only the scheme
			# and host are used.)
			header_up X-Gateway-Callback {scheme}://{host}
			transport http {
				versions 1.1
			}
		}

		forward_auth unix//run/gateway/gateway.sock {
			uri /proxy/verify
			transport http {
				versions 1.1
			}
			@error status 403
			handle_response @error {
				redir * {scheme}://{host}/auth/login
			}
		}
	}
}
