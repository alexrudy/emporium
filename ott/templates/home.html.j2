{% extends "base.html" %}
{% block title %}Sign in{% endblock %}
{% block content %}
<div class="row justify-content-center">
  <div class="col-md-6">
    <div class="card shadow-sm">
      <div class="card-body">
        <h1 class="h4 card-title">ott</h1>
        <p class="card-text text-secondary">
          A tiny app that demonstrates OAuth2 login via the
          <code>oath</code> crate.
        </p>
        <div class="d-grid gap-2">
          {% for provider in providers %}
          <a href="{{ provider.login_path }}" class="btn btn-primary">
            Sign in with {{ provider.name }}
          </a>
          {% endfor %}
        </div>
        <p class="mt-3 small text-secondary mb-1">Provider callback URLs:</p>
        <ul class="small text-secondary mb-0">
          {% for provider in providers %}
          <li>{{ provider.name }}: <code>{{ provider.callback_uri }}</code></li>
          {% endfor %}
        </ul>
      </div>
    </div>
  </div>
</div>
{% endblock %}
